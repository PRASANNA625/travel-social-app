# Copy to .env.local (gitignored) to point the app at a non-production API.
# Unset, the app uses expo.extra.apiUrl from app.json (production).
#   Web on this machine:  http://localhost:4010
#   Android emulator:     http://10.0.2.2:4010
#   Physical device:      http://<your LAN IP>:4010
# EXPO_PUBLIC_API_URL=http://localhost:4010

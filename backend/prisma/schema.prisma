generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TravelMode {
  BIKE
  CAR
  TRAIN
  FLIGHT
  BUS
  TREK
  CAMPING
  BEACH
  MOUNTAIN
  CYCLING
  WATER_ADVENTURE
  BACKPACKING
  WELLNESS
  PHOTOGRAPHY
  INTERNATIONAL
  OTHER
}

// Travel trips and sports meetups share one model, flow and feed.
enum TripCategory {
  TRAVEL
  SPORTS
}

enum Sport {
  CRICKET
  FOOTBALL
  BADMINTON
  TENNIS
  VOLLEYBALL
  BASKETBALL
  CYCLING
  RUNNING
  SWIMMING
  HIKING
  GYM
  OTHER
}

enum SkillLevel {
  ANY
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum JoinType {
  OPEN
  APPROVAL
  INVITE_ONLY
}

enum TripStatus {
  PLANNING
  OPEN
  ALMOST_FULL
  FULL
  STARTED
  COMPLETED
  CANCELLED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Sent by the organizer; waits for the invitee to accept or decline.
  INVITED
}

enum GroupRole {
  OWNER
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
}

enum ReportReason {
  SPAM
  HARASSMENT
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SAFETY_CONCERN
  OTHER
}

enum BuddyConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FeedbackKind {
  REPORT
  FEEDBACK
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// Admin dashboard access, from least to most privileged.
enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  passwordHash   String?
  googleId       String?  @unique
  phone          String?  @unique
  phoneVerified  Boolean  @default(false)
  name           String
  photoUrl       String?
  coverPhotoUrl  String?
  age            Int?
  location       String?
  bio            String?
  interests      String[] @default([])
  preferredModes TravelMode[] @default([])
  preferredLanguage String @default("en")
  lastSeenAt     DateTime?
  role           UserRole      @default(USER)
  status         AccountStatus @default(ACTIVE)
  suspendedAt    DateTime?
  suspendedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips           Trip[]           @relation("TripOwner")
  joinRequests    JoinRequest[]
  tripLikes       TripLike[]
  tripBookmarks   TripBookmark[]
  tripComments    TripComment[]
  tripReviews     TripReview[]
  groupMemberships GroupMember[]
  messages        Message[]
  notifications   Notification[]
  reactions       MessageReaction[]
  reads           MessageRead[]
  feedbackSubmissions AppFeedback[]
  blocksMade      UserBlock[]  @relation("BlocksMade")
  blocksReceived  UserBlock[]  @relation("BlocksReceived")
  reportsMade     UserReport[] @relation("ReportsMade")
  reportsReceived UserReport[] @relation("ReportsReceived")
  buddyRequestsSent     BuddyConnection[] @relation("BuddyRequestsSent")
  buddyRequestsReceived BuddyConnection[] @relation("BuddyRequestsReceived")
  reportsResolved UserReport[] @relation("ReportsResolved")
  messagesRemoved Message[]    @relation("MessagesRemoved")
  auditLogs       AuditLog[]
  announcements   Announcement[]

  @@index([role])
  @@index([status])
}

model BuddyConnection {
  id         String                @id @default(cuid())
  fromUserId String
  fromUser   User                  @relation("BuddyRequestsSent", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User                  @relation("BuddyRequestsReceived", fields: [toUserId], references: [id])
  status     BuddyConnectionStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Trip {
  id                 String     @id @default(cuid())
  ownerId            String
  owner              User       @relation("TripOwner", fields: [ownerId], references: [id])
  title              String
  destination        String
  startLocation      String
  startLat           Float?
  startLng           Float?
  destLat            Float?
  destLng            Float?
  startDate          DateTime
  endDate            DateTime
  travelMode         TravelMode
  category           TripCategory @default(TRAVEL)
  // Sports meetups only. startDate carries the start time; endDate = start + duration.
  sport              Sport?
  durationMinutes    Int?
  skillLevel         SkillLevel?
  budget             Float?
  seats              Int
  seatsFilled        Int        @default(0)
  description        String
  placesToVisit      String[]   @default([])
  groupSizeExpected  Int?
  images             String[]   @default([])
  notes              String?
  joinType           JoinType   @default(APPROVAL)
  status             TripStatus @default(OPEN)
  // Set by admins: featured trips lead Discover; hidden trips are removed from public listings.
  featured           Boolean    @default(false)
  hidden             Boolean    @default(false)
  avgRating          Float?
  reviewCount        Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  joinRequests JoinRequest[]
  likes        TripLike[]
  bookmarks    TripBookmark[]
  comments     TripComment[]
  reviews      TripReview[]
  group        Group?

  @@index([destination])
  @@index([travelMode])
  @@index([category])
  @@index([status])
  @@index([startDate])
}

model JoinRequest {
  id        String            @id @default(cuid())
  tripId    String
  trip      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tripId, userId])
}

model TripLike {
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
}

model TripBookmark {
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
}

model TripComment {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([tripId])
}

model TripReview {
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tripId, userId])
}

model Group {
  id        String        @id @default(cuid())
  tripId    String        @unique
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  members  GroupMember[]
  messages Message[]
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
}

model Message {
  id         String      @id @default(cuid())
  groupId    String
  group      Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type       MessageType @default(TEXT)
  content    String?
  mediaUrl   String?
  durationMs Int?
  createdAt  DateTime    @default(now())
  // Set when a moderator removes the message; its content is then withheld from members.
  removedAt   DateTime?
  removedById String?
  removedBy   User?       @relation("MessagesRemoved", fields: [removedById], references: [id], onDelete: SetNull)

  reactions MessageReaction[]
  reads     MessageRead[]
  reports   UserReport[]

  @@index([groupId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  // A report about one chat message. The snapshot keeps what was said even if
  // the message is later removed; moderators see only this message.
  messageId       String?
  message         Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageSnapshot Json?
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt  DateTime     @default(now())

  @@index([reportedId])
  @@index([status])
  @@index([messageId])
}

model AppFeedback {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          FeedbackKind
  type          String
  description   String
  screenshotUrl String?
  appVersion    String
  platform      String
  status        FeedbackStatus @default(NEW)
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([status])
}

// Every administrative action, kept even if the acting admin's account is deleted.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

// System announcements sent from the admin dashboard (delivered as notifications).
model Announcement {
  id             String   @id @default(cuid())
  title          String
  body           String
  audience       String
  recipientCount Int      @default(0)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Key/value app configuration editable from the admin dashboard (feature switches etc.).
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum HeroBannerStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum HeroMediaType {
  IMAGE
  VIDEO
}

enum HeroTextAlign {
  LEFT
  CENTER
  RIGHT
}

// A slide in the Discover hero carousel, managed from the admin dashboard.
// Media lives in object storage (Cloudinary, or local uploads in development);
// only its URL and storage key are kept here.
model HeroBanner {
  id             String           @id @default(cuid())
  title          String
  status         HeroBannerStatus @default(DRAFT)
  mediaType      HeroMediaType
  mediaUrl       String
  mediaKey       String?
  posterUrl      String?
  posterKey      String?
  // CSS object-position keyword used when the media is cropped to fit.
  focalPoint     String           @default("center")
  heading        String?
  subtitle       String?
  tagline        String?
  textColor      String           @default("#FFFFFF")
  overlayOpacity Float            @default(0.45)
  textAlign      HeroTextAlign    @default(LEFT)
  ctaLabel       String?
  ctaUrl         String?
  displayOrder   Int              @default(0)
  // Shown only between these times (either may be open-ended).
  startsAt       DateTime?
  endsAt         DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, displayOrder])
}
